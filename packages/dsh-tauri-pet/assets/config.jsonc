// dsh-tauri-pet 内置桌宠配置（JSONC：允许 // 与 /* */ 注释）。
// 协议对齐子仓库 source/dsh-pet/dsh-pet/assets/config.jsonc（animations /
// animationWeights / pets / physics / eventsRefreshSec / events），唯一差异：
// 动画池条目引用的是 dsh-tauri-pet 内置资产键（src-tauri/src/bridge/pet.rs 的
// BUILTIN_ASSET_NAMES：idle / turn / move / drag / wave / waiting / running /
// review / failed / bubble / fallback），而不是任意 webm 文件名——运行时资产由
// Rust 从内置插件目录白名单加载，池里写了不存在的键会在加载层显式报错。
{
  // ===================== 宠物列表（内置宠物唯一来源） =====================
  // id = BUILTIN_PET_ID（maid-deepseek-whale）；size 为舞台宽度（px），
  // 高度自动 = size × 9/16。DSH 桌宠为独立透明置顶窗口，display 固定 desktop。
  "pets": [
    {
      "name": "Maid DeepSeek Whale",
      "id": "maid-deepseek-whale",
      "size": 220,
      "balanceEnabled": false,
      "whisperEnabled": false,
      "display": "desktop",
      "position": {
        "corner": "bottom-right",
        "marginX": 24,
        "marginY": 16
      }
    }
  ],

  // ===================== 动作动画池配置 =====================
  // 与 dsh-pet 协议同构；每项是内置资产键数组（见上方说明），
  // 数组可放多个同档动画，运行时等概率抽取（当前内置资产每档只有 1 个）。
  "animations": {
    // 待机动画池（循环播放）
    "idle": ["idle"],
    // 转向动画池（播完翻转朝向的一次性动画）
    "turn": ["turn"],
    // 拖拽动画池（被无形抓起悬空的姿势）
    "drag": ["drag"],
    // 点击回应动画池（点按宠物时随机抽 1 个）
    "clicks": ["wave"],
    // 移动动画池：default 为通用参数，actions 可覆盖部分参数
    // （DSH 已移除自动漫游，move 权重仅保留协议字段，运行时不再主动移动窗口）
    "moves": {
      "default": { "minDist": 60, "maxDist": 240, "margin": 20, "leadSec": 2, "tailSec": 2 },
      "actions": [
        { "name": "move" }
      ]
    },
    // 随机动作分类池：weight 为该分类出现权重；抽中 action 时按权重选分类，
    // 再从分类 actions 中等概率抽一个播放一次。
    "categories": [
      {
        "id": "小动作",
        "weight": 80,
        "actions": ["wave", "bubble", "turn"]
      }
    ],
    // 事件动画：不进随机链，只由代码显式触发（DSH 当前保留协议字段，
    // 会话状态动画由 session:* 事件直接驱动，不使用 events 池）。
    "events": {
      "balance": ["bubble"],
      "whisper": ["bubble"]
    }
  },

  // ===================== 事件触发周期（协议保留字段） =====================
  "eventsRefreshSec": {
    "balance": 1800,
    "whisper": 300
  },

  // ===================== 动画链顶层权重 =====================
  // idle/turn/move 权重之和 + 上面各分类 weight 合计 = 100。
  // 当前：10 + 5 + 5 + 80 = 100。抽中 move 时因 DSH 无自动漫游而保持待机。
  "animationWeights": {
    "idle": 10,
    "turn": 5,
    "move": 5
  },

  // ===================== 宠物物理（协议保留字段） =====================
  // DSH 桌宠使用系统原生窗口拖拽（startDragging），不使用抛掷物理；
  // 字段保留与 dsh-pet 默认值一致，便于未来对齐交互。
  "physics": {
    "gravity": 1400,
    "restitution": 0.78,
    "groundFriction": 2.5,
    "ceilingBounce": true,
    "throwPower": 1.0,
    "petCollision": false
  }
}
