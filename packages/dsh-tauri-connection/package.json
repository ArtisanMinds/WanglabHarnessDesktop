{
  "name": "dsh-tauri-connection",
  "type": "module",
  "version": "1.0.0",
  "author": "Hairyf <wwu710632@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/dsh-tauri-desk/dsh-tauri-plugins#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-tauri-desk/dsh-tauri-plugins.git"
  },
  "bugs": "https://github.com/dsh-tauri-desk/dsh-tauri-plugins/issues",
  "keywords": [
    "dsh",
    "plugin",
    "dsh-plugin",
    "tauri",
    "deepseek-harness"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "cordis.patch.yml",
    "dist"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "nr build",
    "start": "tsx src/index.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "dsh-tauri": "workspace:*"
  },
  "devDependencies": {
    "dsh-tauri-tsdown": "workspace:*",
    "tsdown": "catalog:cli"
  }
}
